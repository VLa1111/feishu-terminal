# 飞书开放平台「自建应用」的凭证与基础信息里获取
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 允许使用终端的用户 open_id，逗号分隔（务必只填你自己）
# 不知道自己的 open_id 时先留空，跑起来后给 bot 发条消息，日志里会打印出来
FEISHU_ALLOW_OPEN_IDS=

# 可选：要跑的 shell，默认 /bin/zsh（bot 专用 zshrc 在 zsh/ 目录，提供 oh-my-zsh + 地址栏提示符）
FEISHU_SHELL=/bin/zsh

# ---- 以下都有默认值，按需覆盖 ----
# 同步等待命令的时长；超时先回执，命令继续跑，结束后自动推送结果
# FEISHU_EXEC_TIMEOUT=8s
# 后台任务最长跟踪时长（只停止跟踪，不杀进程）
# FEISHU_MAX_JOB_DURATION=30m
# 单条消息最多显示多少字节，超过则把完整输出作为文件发送
# FEISHU_OUTPUT_LIMIT=3000
# tmux socket 名，用于和用户自己的 tmux 隔离
# FEISHU_TMUX_SOCKET=feishu-terminal
# 终端尺寸（列 x 行）
# FEISHU_TERM_COLS=120
# FEISHU_TERM_ROWS=40
# 可选：手动指定本 bot 的 open_id（默认自动通过接口获取）
# FEISHU_BOT_OPEN_ID=

# ---- 在线升级（可选）----
# 新版本清单地址（release.json）。设置后 /upgrade、/checkupdate 可以不带地址参数。
# GitHub Release 的固定地址（每次发布 v* tag 由 Actions 自动更新）：
# FEISHU_UPDATE_URL=https://github.com/VLa1111/feishu-terminal/releases/latest/download/release.json
# 也可以指向任何静态 HTTP(S) 服务下的 release.json（make dist 会生成）。
# 后台自动检查间隔，例如 6h；不设置则只在手动 /checkupdate 时检查（发现新版本会通知最近活跃的聊天）
# FEISHU_UPDATE_CHECK=6h
